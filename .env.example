# Copy to .env and adjust as needed. Read by src/config.py.

# Postgres connection (also used by docker-compose.yml)
POSTGRES_USER=medref
POSTGRES_PASSWORD=medref
POSTGRES_DB=medref
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy/psycopg URL; if unset, src/config.py builds it from the parts above.
DATABASE_URL=postgresql+psycopg://medref:medref@localhost:5432/medref

# API
API_HOST=0.0.0.0
API_PORT=8000

# Enrichment (src/enrich.py) — offline reads data/atc_reference.csv by default
ATC_REMOTE_LOOKUP=false

# Optional /v1/ask endpoint (SPEC.md §6.1) — DeepSeek (OpenAI-compatible) API key
DEEPSEEK_API_KEY=

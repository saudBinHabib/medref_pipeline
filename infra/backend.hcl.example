# Copy to backend.hcl (gitignored) and fill in after `infra/bootstrap` has
# been applied. Then run:
#   terraform init -backend-config=backend.hcl
bucket         = "medref-tfstate-<account_id>"
key            = "medref/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "medref-tf-locks"
encrypt        = true
